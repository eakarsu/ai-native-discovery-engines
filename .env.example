DATABASE_URL=postgresql://app_user:replace_me@127.0.0.1:5432/discovery_db
JWT_SECRET=replace-with-at-least-32-random-characters
DEFAULT_TENANT_ID=replace-with-tenant-id
CORS_ORIGIN=http://localhost:5173

# Non-push connectors accept only references; resolve these in deployment.
DISCOVERY_SOURCE_CONFIG_REF=vault:discovery/source
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
